{
  "manifest_version": 3,
  "name": "Calculador Distância Effecti",
  "version": "2.1",
  "permissions": ["storage", "activeTab", "scripting"],
  "icons": {
    "16": "lib/images/marker-icon.png",
    "32": "lib/images/marker-icon.png",
    "48": "lib/images/marker-icon-2x.png",
    "128": "lib/images/marker-icon-2x.png"
  },
  "host_permissions": [
    "https://*.effecti.com.br/*",
    "https://*.portaldecompraspublicas.com.br/*",
    "https://app2.licitardigital.com.br/*",
    "https://pncp.gov.br/*",
    "https://nominatim.openstreetmap.org/*",
    "https://photon.komoot.io/*",
    "https://*.tile.openstreetmap.de/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "lib/images/marker-icon.png",
      "32": "lib/images/marker-icon.png",
      "48": "lib/images/marker-icon-2x.png",
      "128": "lib/images/marker-icon-2x.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.effecti.com.br/*",
        "https://*.portaldecompraspublicas.com.br/processos/*",
        "https://app2.licitardigital.com.br/pesquisa/*",
        "https://pncp.gov.br/*"
      ],
      "js": [
        "utils.js",
        "provedores/effecti.js",
        "provedores/portalCompras.js",
        "provedores/licitardigital.js",
        "provedores/pncp.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/images/*.png"],
      "matches": ["https://*.effecti.com.br/*"]
    }
  ]
}